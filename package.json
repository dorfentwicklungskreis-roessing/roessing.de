{
  "name": "roessing.de",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "setup": "npm install && npx allow-scripts && npx lefthook install && node scripts/decrypt.js",
    "encrypt": "node scripts/encrypt.js",
    "decrypt": "node scripts/decrypt.js",
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "vitest",
    "astro": "astro",
    "prettier": "prettier -c .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "unlighthouse": "unlighthouse-ci --site http://127.0.0.1:4321",
    "performance:check": "start-server-and-test preview 4321 unlighthouse",
    "performance:build": "start-server-and-test preview 4321 'pnpm unlighthouse --build-static'",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "playwright test",
    "format": "biome check --write .",
    "shortlink": "node scripts/assign-event-shortlink.js",
    "event-qr": "node scripts/generate-event-qr.js",
    "print-qr": "node scripts/generate-print-qr.js",
    "typst:ensure": "node scripts/ensure-typst.js",
    "fonts:ensure": "node scripts/ensure-fonts.js",
    "claude": "claude --dangerously-skip-permissions"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@inox-tools/sitemap-ext": "^0.11.0",
    "@levino/shipyard-base": "^0.9.4",
    "@levino/shipyard-docs": "^0.9.4",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/vite": "^4",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "astro": "^7.4.2",
    "astro-navbar": "^2.3.0",
    "classnames": "^2.3.2",
    "daisyui": "^5",
    "fp-ts": "^2.16.1",
    "fp-ts-std": "^0.18.0",
    "io-ts": "^2.2.20",
    "ramda": "^0.29.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "satori": "^0.33.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.0.0",
    "@biomejs/biome": "2.2.7",
    "@lavamoat/allow-scripts": "^3.4.1",
    "@playwright/test": "^1.48.2",
    "@types/js-yaml": "^4.0.9",
    "@types/ramda": "^0.29.9",
    "@unlighthouse/cli": "^0.14",
    "cypress": "^13.15.2",
    "js-yaml": "^4.1.0",
    "lefthook": "^2.0.4",
    "puppeteer": "^23",
    "qrcode": "^1.5.4",
    "start-server-and-test": "^2.0.3",
    "vitest": "^4.0.0"
  },
  "lavamoat": {
    "allowScripts": {
      "@unlighthouse/cli>@unlighthouse/server>listhen>@parcel/watcher": true,
      "astro>esbuild": true,
      "astro>sharp": true,
      "cypress": true,
      "puppeteer": true,
      "vitest>vite-node>vite>esbuild": true,
      "vitest>vite>esbuild": true,
      "lefthook": true
    }
  }
}
